# Supabase (canonical database + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=video-assets
SIGNED_URL_EXPIRES_SECONDS=3600

# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend (no VITE_ prefix)

# Environment
ENV=development
SKIP_SUPABASE_VALIDATION=false

# Storage (local fallback for tests only; production uses supabase)
STORAGE_PROVIDER=supabase
STORAGE_DIR=./storage

# Redis (job queue)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# AI
OPENAI_API_KEY=
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-4o
TTS_PROVIDER=edge

# TTS voices per language
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_RU=ru-RU-SvetlanaNeural
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Audio processing
MUSIC_VOLUME_DB=-18
VOICE_NORMALIZE=true
MAX_SPEED_FACTOR=1.10
ALIGNMENT_RETRY_THRESHOLD=1.30
VOICE_SEPARATION_ENABLED=true
AUDIO_DRIFT_TOLERANCE_MS=100

# CORS
CORS_ORIGINS=http://localhost:5173

# Public URL (for QR codes)
PUBLIC_BASE_URL=http://localhost:5173

# Worker
USE_ARQ=false
