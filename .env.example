# Supabase database (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Environment
ENV=development
SKIP_SUPABASE_VALIDATION=false

# Storage: local | supabase | r2
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
SUPABASE_STORAGE_BUCKET=video-assets
SIGNED_URL_EXPIRES_SECONDS=7200

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
S3_BUCKET=video-assets
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=500

# Admin authentication — replace all production values
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Subtitle draft translation (optional; manual uploads work without it)
TRANSLATION_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
TRANSLATION_MODEL=gpt-4o

# Media inspection
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Browser/API origins
CORS_ORIGINS=http://localhost:5173,https://your-site.pages.dev
PUBLIC_BASE_URL=http://localhost:5173

# Demo limits
MAX_SUBTITLE_MB=5
